[Unit]
Description=Concord — watchdog sweep every 30 minutes, 06:00–18:30 ET daily (Persistent=false: a missed health check must never fire stale)

[Timer]
# Hours 06–18, minutes :00/:30 → 06:00 … 18:30 ET. The 18:30 fire is the one
# that catches "no ballot on the eve of a vote day" (open-vote fires 18:00).
OnCalendar=*-*-* 06..18:00/30 America/New_York
Persistent=false

[Install]
WantedBy=timers.target
