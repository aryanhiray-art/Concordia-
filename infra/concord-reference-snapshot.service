[Unit]
Description=Concord — snapshot the Alpaca reference account into reference_nav

[Service]
Type=oneshot
User=concord
Group=concord
WorkingDirectory=/opt/concord/backend
EnvironmentFile=/opt/concord/.env
ExecStart=/opt/concord/backend/.venv/bin/python jobs/reference_snapshot.py
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/concord
UMask=077
