[Unit]
# NO .timer SHIPS FOR THIS UNIT, DELIBERATELY. It used to have one, dated
# 2026-06 with Persistent=true — and setup-host.sh globs infra/concord-*.timer
# onto the box, so rebuilding the host would have installed a past-dated
# catch-up trigger for a liquidation. Catch-up firing is a timer-only
# property, so removing the timer removes the automatic path entirely.
# Run it deliberately when it is genuinely wanted:
#   systemctl start concord-fresh-start.service
Description=Concord — one-shot FRESH START: liquidate every connected member's club holdings to cash

[Service]
Type=oneshot
User=concord
Group=concord
WorkingDirectory=/opt/concord/backend
EnvironmentFile=/opt/concord/.env
ExecStart=/opt/concord/backend/.venv/bin/python jobs/fresh_start.py
TimeoutStartSec=600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/concord
# app-created files (DB, WAL) default to 0600, not 0644
UMask=077
