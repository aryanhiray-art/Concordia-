[Unit]
Description=Concord — refresh every member's cached account snapshot (balance, allocation, P&L, holdings) so the member pages never wait on Robinhood

[Service]
Type=oneshot
User=concord
Group=concord
WorkingDirectory=/opt/concord/backend
EnvironmentFile=/opt/concord/.env
ExecStart=/opt/concord/backend/.venv/bin/python jobs/refresh_accounts.py
TimeoutStartSec=600
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/concord
# app-created files (DB, WAL) default to 0600, not 0644
UMask=077
