# ─── Concord backend config ─────────────────────────────────────────────────
# Copy to .env (chmod 600). NEVER commit the real .env.

APP_ENV=dev                              # dev | beta | prod
# 'beta' is a real third value, not a typo: config.is_beta hard-forces is_live
# False, so the staging channel holds real member tokens but can never place a
# real order (see backend/app/config.py is_live / is_internet_facing).

# Storage (owned by the `concord` unix user, mode 700)
CONCORD_DB_PATH=./concord.db

# Secrets — generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-session-secret
# Token-vault key — generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CONCORD_FERNET_KEY=change-me-fernet-key
# Static service token the forge-dashboard uses to reach the owner/admin endpoints
# backend-to-backend (no member session). Empty = that shortcut is disabled.
# Generate with:  python3 -c "import secrets;print('svc-'+secrets.token_urlsafe(24))"
# MUST differ between dev and prod. Treat as break-glass — rotate periodically.
# (setup-host.sh mints one on the VPS if this is empty; back it up out-of-band.)
CONCORD_ADMIN_TOKEN=

# Club access
INVITE_CODE=change-me-invite-code
OWNER_EMAIL=rohannj29@gmail.com

# Web / CORS / OAuth redirect target (the Vercel app, and locally http://localhost:3000)
WEB_ORIGIN=http://localhost:3000
# Public base URL of THIS api (used to build the Robinhood OAuth callback).
# Locally this is the api itself; in prod it's the nginx vhost, e.g. https://concord-api.example.com
API_PUBLIC_URL=http://localhost:8780

# ─── Transactional email (Resend) — signup verification + password reset ─────
# Empty RESEND_API_KEY = the feature is INERT (signup works exactly as before,
# no codes required, /forgot sends nothing). Get a key at https://resend.com;
# the From domain must be verified in Resend. DEMO_MODE prints mails to stdout
# ("DEMO-MAIL to=...") instead of sending, so the sandbox flow works keyless.
RESEND_API_KEY=
MAIL_FROM="Concordia <no-reply@voteconcordia.com>"

# ─── Robinhood Agentic Trading (discovery metadata verified 2026-06-12) ──────
RH_RESOURCE=https://agent.robinhood.com/mcp/trading
RH_REGISTER_URL=https://agent.robinhood.com/oauth/trading/register
RH_AUTHORIZE_URL=https://robinhood.com/oauth
RH_TOKEN_URL=https://api.robinhood.com/oauth2/token/
RH_SCOPE=internal
# Optional: a pre-registered public client_id (else we register one on first boot
# and cache it in the DB). Registration must include our callback redirect_uri.
RH_CLIENT_ID=

# ─── Trading behaviour ───────────────────────────────────────────────────────
EXECUTION_MODE=dry_run                    # dry_run | live  (start dry_run!)
# Deliberately dry_run here even though the LIVE box runs EXECUTION_MODE=live:
# an example file must never be copyable into a real-money configuration.
# Going live is a human action taken on the box, not something a deploy does.
TOP_N=20                                    # consensus basket size (top-N by votes)
MAX_PICKS=20                                # most a member may add to their ballot

# ── Cadence ──────────────────────────────────────────────────────────────────
# ABSENT KEY = config.py's default 'alternate' (every OTHER trading day), which
# is the TESTING default and is NOT what the live club runs. A fresh deployment
# that omits this line trades on a different calendar than production.
CYCLE_CADENCE=daily                        # daily|alternate|weekly|mwf — live = daily
# ABSENT KEY = 'weekly'. The live club redistributes voting power every OTHER
# Sunday, anchored on POWER_ANCHOR (which must be a Sunday the power timer
# actually fires on).
POWER_CADENCE=biweekly                     # weekly|biweekly|monthly — live = biweekly
POWER_ANCHOR=2026-08-23                    # Sunday the biweekly parity counts from
# PER-DEPLOYMENT, not a value to copy: the cadence is dormant before this date,
# so it must be YOUR club's first trading day. config.py's default is
# 2026-06-23; the live box carries 2026-07-22.
CYCLE_START_DATE=2026-06-23

# Schedule, US/Eastern (jobs are market-calendar gated, and only fire on days
# the cadence above says are cycle days). These MUST agree with the systemd
# timers — the timer decides when the job runs, this decides what the job
# thinks the time is. Live timers: concord-close-vote 09:15 ET,
# concord-execute 10:15 ET (verified on the box 2026-09-23).
VOTE_OPEN_AT=18:00                         # opens next trading day's session
VOTE_CLOSE_AT=09:15                        # locks votes + tallies (15m before the open)
EXECUTE_AT=10:15                           # places the basket

# Sizing: deploy ALL buying power across the basket.
# 0 = no reserve (owner call 2026-08-24, config.py:121-128). The reserve existed
# so the last dollar order could not trip a buying-power reject, but it silently
# stranded that % of every FULLY-committed account: a member whose stake is 100%
# of their cash had 1% less deployable than their budget, so the final name
# deferred every cycle. A rejected last order is recorded and retried; a
# permanently undeployable slice was not.
#
# OPERATOR NOTE — the LIVE box is still CASH_BUFFER_PCT=1, i.e. it has NOT been
# moved to the owner's stated intent of 0. If a live member reports one basket
# name never getting bought, this is the first thing to check.
CASH_BUFFER_PCT=0                           # % of buying power kept as cash reserve
MAX_ORDERS=25                              # hard per-member order ceiling per run

# Source of the per-member club POSITION used for sell/liquidation sizing.
# ABSENT KEY = config.py's default 'ledger' — the legacy estimate-based
# executions sum, which drifted 16-90x HIGH. On a real-money instance that is
# the drift-prone setting; 'derived' reconstructs the position from the broker's
# own agentic order feed, so it is anchored to reality and can only UNDER-count
# (it will never sell a member's personal shares).
CLUB_POSITION_SOURCE=derived               # ledger | derived — live = derived

# Human-quorum floor: fewest HUMAN voters before the executor places REAL
# orders. ABSENT KEY = config.py's default 1. The live box runs 0 — the owner
# does not want execution blocked on low turnout, so do not "restore" a floor
# here and assume it matches production.
MIN_HUMAN_VOTERS=0

# Hard safety caps (enforced in alloc.rebalance_budget — clamps every member's
# rebalance budget AND their voting-power stake). Per-member daily_cap_usd is
# stored in member_settings but NOT yet enforced at the executor call site.
MAX_NOTIONAL_PER_MEMBER=2000               # global per-member $ ceiling per cycle

# AI voting bot containment (bots vote, never trade)
BOT_POWER_CAP=300                          # per-bot voting-power ceiling ($)
BOT_TALLY_SHARE_MAX=0.90                   # max aggregate bot share of the tally weight (0-1)

# ── Voting power (services/reputation.py) ────────────────────────────────────
# POWER_MODEL=blend enables money+merit weighting. POWER_FORM then picks the
# score function: 'legacy' is the additive form, 'merit' is v2 (one product,
# one normalisation — an exit becomes a pure renormalisation, no zero-cliff,
# bounded spread). merit REQUIRES blend and the app refuses to boot otherwise.
# ABSENT KEY = config.py's default 'stake' (committed stake only), NOT 'blend'.
POWER_MODEL=blend
# ABSENT KEY = config.py's default 'legacy' (the additive form). The live box
# runs 'merit' (the v2 product form). 'merit' REQUIRES POWER_MODEL=blend and the
# app refuses to boot otherwise — under 'stake' it would be silently ignored.
POWER_FORM=merit
# The most a track record can be worth: M in [1/MM, MM], so best:worst <= MM^2.
MERIT_MAX_MULTIPLE=2.0
# One unit of track record, in absolute accuracy (100bps of excess vs SPY).
# The dial to turn; leave MERIT_MAX_MULTIPLE alone (it is the safety bound).
MERIT_ACCURACY_SCALE=0.010
# Winsorises one cycle's excess before it enters the EWMA. Sits above every
# excess the club has ever recorded (max 6.69%) — a guard against a stale or
# gapped price pair booking a multi-week move as one cycle, not a tuning knob.
ACCURACY_EXCESS_CAP=0.10
# Club size at which today's EWMA half-lives are the reference speed. Accuracy
# moves max(1, sqrt(N/REF)) times more slowly as the club grows past it.
ACCURACY_INERTIA_REF_N=24
# Per-member ceiling on share of the vote. 0 = off. A ceiling of C needs C*N > 1
# to be satisfiable at all, and roughly N >= 2/C before it bounds an outlier
# instead of flattening the club — leave off until ~50 members, then 0.10.
MAX_VOTING_SHARE=0.0
# 0 = derive the activation threshold as ceil(2/MAX_VOTING_SHARE).
MAX_VOTING_SHARE_MIN_MEMBERS=0
