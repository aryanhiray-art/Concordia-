[Unit]
Description=Concord DEMO API (FastAPI/uvicorn) — fake-money demo instance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=concord-demo
Group=concord-demo
WorkingDirectory=/opt/concord-demo/backend
EnvironmentFile=/opt/concord-demo/.env
ExecStart=/opt/concord-demo/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8781
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/concord-demo
PrivateTmp=true
UMask=077

[Install]
WantedBy=multi-user.target
