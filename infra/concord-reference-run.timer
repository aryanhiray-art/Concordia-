[Unit]
Description=Concord — reference-account mirror, after each trading day's execution

[Timer]
# 30 minutes after concord-execute.timer (10:15 ET) so the basket it mirrors is
# the one members actually received, and comfortably inside market hours — a
# notional order outside 09:30-16:00 is rejected, not queued.
#
# Mon-Fri, matching concord-execute.timer: the club moved back to a daily
# cadence (sessions 09-02/03/04 are consecutive trading days). The first
# version of this timer was Monday-only from the weekly era, which would have
# mirrored one basket in five — a record of a different, slower strategy than
# the one members run. These two timers move together, always.
OnCalendar=Mon-Fri *-*-* 10:45 America/New_York

# Persistent=false deliberately. A missed run must NOT fire on boot: it would
# place a stale basket at whatever time the box came back, possibly outside
# market hours. A skipped week is a gap in the series; a late one is bad data.
Persistent=false

[Install]
WantedBy=timers.target
