[Unit]
Description=Concord — morning admin digest emails owner+cofounder the exception report (will-place verdict, member exceptions, cycle preflight)

[Service]
Type=oneshot
User=concord
Group=concord
WorkingDirectory=/opt/concord/backend
EnvironmentFile=/opt/concord/.env
ExecStart=/opt/concord/backend/.venv/bin/python jobs/admin_digest.py
TimeoutStartSec=300
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/concord
# app-created files (DB, WAL) default to 0600, not 0644
UMask=077
