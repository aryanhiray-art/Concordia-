[Unit]
Description=Concord — bots vote in three retryable passes, every trading day

[Timer]
# DAILY cadence (CYCLE_CADENCE=daily): a new ballot opens each evening at 18:00
# and closes the next morning at 09:15 ET, so the bots have to vote on EVERY
# trading day. The old Wed/Sat/Mon schedule belonged to the weekly cadence,
# where one ballot stayed open all week; leaving it in place under daily would
# have meant bots voting on three days out of five and the other days deciding
# a real-money basket on whatever thin human turnout existed.
#
# Same three-pass design as before, all finishing before the 09:15 close:
#   05:30 — first basket off the overnight ballot
#   07:00 — retry: only the bots the first pass never reached
#   08:20 — final pass, ~55 minutes of headroom before the close
# A pass that dies loses nothing: the previous pass's votes stand, and a retry
# only re-runs the bots the killed attempt never reached (see jobs/bot_vote.py).
#
# Mon-Fri only: the job is cheap but pointless on a weekend, and the ballot it
# would vote in is not traded until the next trading day anyway.
OnCalendar=Mon-Fri *-*-* 05:30 America/New_York
OnCalendar=Mon-Fri *-*-* 07:00 America/New_York
OnCalendar=Mon-Fri *-*-* 08:20 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
