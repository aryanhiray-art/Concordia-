[Unit]
Description=Concord API — BETA channel (staging: real broker flows, dry-run only, own DB on :8782)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=concord-beta
Group=concord-beta
WorkingDirectory=/opt/concord-beta/backend
# /opt/concord-beta/.env must set APP_ENV=beta (the config-level hard lock that
# forces is_live=False no matter what) and EXECUTION_MODE=dry_run — plus its own
# CONCORD_FERNET_KEY/SESSION_SECRET, never the live box's.
EnvironmentFile=/opt/concord-beta/.env
ExecStart=/opt/concord-beta/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8782
Restart=on-failure
RestartSec=5
# hardening — beta can't see the live instance's secrets (and vice-versa)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/concord-beta
PrivateTmp=true
# app-created files (DB, WAL) default to 0600, not 0644
UMask=077

[Install]
WantedBy=multi-user.target
