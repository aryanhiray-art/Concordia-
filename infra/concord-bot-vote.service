[Unit]
Description=Concord — AI bots vote in the day's session (Ollama)

[Service]
Type=oneshot
User=concord
Group=concord
WorkingDirectory=/opt/concord/backend
EnvironmentFile=/opt/concord/.env
# Low priority: 20 local LLM inferences are CPU-heavy; yield to other services.
Nice=10
CPUWeight=30
IOWeight=30
ExecStart=/opt/concord/backend/.venv/bin/python jobs/bot_vote.py
# Each attempt must END before the next one starts, so a wedged run is killed
# and retried rather than squatting the whole pass. Monday's attempts are the
# tightest (05:30 / 07:00 / 08:20 ET, ballot closes 09:15), so 3000s < the 80min
# minimum gap. Being killed mid-loop is no longer destructive: bots that already
# voted today are skipped on the retry, so attempts accumulate turnout instead
# of restarting from zero (the 2026-08-24 failure mode).
TimeoutStartSec=3000
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/concord
# app-created files (DB, WAL) default to 0600, not 0644
UMask=077
